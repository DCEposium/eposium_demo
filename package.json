{
  "name": "epos-messe-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "predev": "npm run sync-brand",
    "dev": "vite",
    "prebuild": "npm run sync-brand",
    "build": "tsc -b && vite build",
